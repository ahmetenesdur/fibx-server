# Privy credentials (required)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# JWT secret for session tokens (required, min 32 chars)
# Generate: openssl rand -base64 32
JWT_SECRET=

# Server port (optional, default: 3001)
PORT=3001

# Public URL (optional, for Origin header in production)
# If not set, defaults to http://localhost:3001
PUBLIC_URL=

# Allowed CORS origins (optional, comma-separated)
# Leave empty for CLI-only access (no browser CORS needed)
ALLOWED_ORIGINS=

# Reverse proxies in front of this service (optional, default: 1)
# Rate limiting counts this many entries from the right of X-Forwarded-For.
# Set 0 when directly exposed so forwarding headers are never trusted.
TRUST_PROXY_HOPS=1

# Chain IDs this deployment will sign for (optional)
# Default: Base, Citrea, HyperEVM, Monad
ALLOWED_CHAIN_IDS=8453,4114,999,143

# Privy policy attached to new agent wallets (optional)
# Leave unset on first run: the server creates one and logs its id — then pin
# it here so restarts reuse it instead of creating duplicates.
WALLET_POLICY_ID=

# Per-transaction native value caps for the wallet policy (optional)
# Format: chainId:amountInNativeUnits — enforced at Privy's signing layer.
WALLET_POLICY_MAX_TX_NATIVE=8453:0.5,4114:0.005,999:25,143:500
